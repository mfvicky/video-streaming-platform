{
  "name": "video-streaming-platform",
  "version": "1.0.0",
  "packageManager": "pnpm@9.4.0",
  "description": "",
  "main": "index.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@scarf/scarf"
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter web test",
    "test:worker": "pnpm --filter worker test",
    "test:worker:real": "pnpm --filter worker exec vitest run src/services/ffmpeg.real.test.ts",
    "test:e2e": "pnpm --filter api exec node scripts/integration-media.mjs",
    "prepare": "husky",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:api:once": "pnpm --filter api dev:once",
    "dev:worker": "pnpm --filter worker dev",
    "db:migrate": "pnpm --filter @app/db exec prisma migrate dev",
    "db:generate": "pnpm --filter @app/db exec prisma generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm --filter @app/shared build && pnpm --filter @app/db build && pnpm --filter api build && pnpm --filter worker build && pnpm --filter web build",
    "build:shared": "pnpm --filter @app/shared build",
    "build:db": "pnpm --filter @app/db build",
    "build:api": "pnpm --filter api build",
    "build:worker": "pnpm --filter worker build",
    "build:web": "pnpm --filter web build"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "dotenv": "^18.0.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
