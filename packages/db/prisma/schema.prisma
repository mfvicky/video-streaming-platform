generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CREATOR
  ADMIN
}

enum VideoStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  videos        Video[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Video {
  id            String      @id @default(uuid())
  title         String
  status        VideoStatus @default(PENDING)
  rawPath       String
  thumbnailPath String?
  // FFprobe metadata (null until the worker probes the original file).
  durationSeconds Float?
  width           Int?
  height          Int?
  videoCodec      String?
  fileSizeBytes   Int?
  bitrate         Int?
  audioChannels   Int?
  // A unique job ID prevents stale / duplicate queue messages from processing.
  processingJobId    String?
  processingLeaseUntil DateTime?
  processingAttempts Int @default(0)
  processingError    String?
  processingStartedAt DateTime?
  processedAt         DateTime?
  viewCount           Int @default(0)
  downloadCount       Int @default(0)
  creatorId     String
  creator       User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([creatorId])
  @@index([creatorId, status, createdAt])
  @@index([status, processingLeaseUntil])
  @@index([createdAt])
}