# Safe sample values only. For an actual setup, run: node scripts/setup-env.mjs
# Do not overwrite an existing .env: it contains your passwords and RSA keys.
COMPOSE_PROJECT_NAME=video-streaming-platform

# Database
POSTGRES_USER=app
POSTGRES_PASSWORD=change_this_database_password
POSTGRES_DB=app_db
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=streamuser
RABBITMQ_DEFAULT_PASS=change_this_rabbitmq_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# S3-compatible storage (MinIO / SILO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# HTTP services
API_PORT=3000
WEB_PORT=3001
CORS_ORIGIN=http://localhost:3001
# Vite uses this BROWSER-visible URL at Docker build time
VITE_API_URL=http://localhost:3000/api

# Rate limiting / logging
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
LOG_LEVEL=info

# Generate these with scripts/setup-env.mjs; do not use placeholders in production
JWT_SECRET=REPLACE_ME_WITH_RANDOM_SECRET
REFRESH_SECRET=REPLACE_ME_WITH_ANOTHER_RANDOM_SECRET
RSA_PUBLIC_KEY=REPLACE_ME_WITH_PEM_KEY
RSA_PRIVATE_KEY=REPLACE_ME_WITH_PEM_KEY

# false for http://localhost; true behind HTTPS in deployment.
COOKIE_SECURE=false
